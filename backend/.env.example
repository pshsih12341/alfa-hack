# Копируйте в .env и настраивайте под окружение.
# DATABASE_URL=sqlite:///./credit_kiosk.db        # быстрый старт (без внешнего сервера)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/db  # если есть Postgres

DATABASE_URL=sqlite:///./credit_kiosk.db
COOKIE_NAME=ck_session
COOKIE_MAX_AGE=2592000        # 30 дней
COOKIE_SECURE=false           # true в продакшне только по HTTPS
COOKIE_SAME_SITE=lax
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
